# Public Azure Function endpoint. Safe to commit.
export SMARTSERVICE_API_URL="https://smartservice-demo-func-aioknthas2bwa.azurewebsites.net/api/voice/turn"

# Replace only on the Raspberry Pi. Never commit the real device key.
export SMARTSERVICE_DEVICE_KEY="<DEVICE_KEY_FROM_AZURE_KEY_VAULT>"

# Foundry plus Speech can take longer than a local request.
export SMARTSERVICE_REQUEST_TIMEOUT_SECONDS="25"
