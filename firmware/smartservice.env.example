# Public Azure Function endpoint. Safe to commit.
SMARTSERVICE_API_URL="https://smartservice-demo-func-aioknthas2bwa.azurewebsites.net/api/voice/turn"

# Replace only on the Raspberry Pi. Never commit the real device key.
SMARTSERVICE_DEVICE_KEY=""

# Foundry plus Speech can take longer than a local request.
SMARTSERVICE_REQUEST_TIMEOUT_SECONDS="25"

# Run `python -m sounddevice` and put the USB input device index here.
SMARTSERVICE_MICROPHONE_DEVICE=""

# gpiozero backend for current Raspberry Pi OS releases.
GPIOZERO_PIN_FACTORY="lgpio"
